# Groundframe UAV Visual Localization — Environment Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# --- 3D Map Visualization (CesiumJS + Google Photorealistic 3D Tiles) ---
# Recommended: Free Cesium ion token (https://ion.cesium.com/tokens)
# Includes Google Photorealistic 3D Tiles (asset 2275207) out of the box.
CESIUM_ION_TOKEN=

# Optional: Direct Google Maps Map Tiles API key (alternative to Cesium ion for Google 3D Tiles)
GOOGLE_MAPS_API_KEY=

# --- Video-Only Cold Start (VLM Region Detection via OpenRouter) ---
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Vision-capable model on OpenRouter used to infer approximate (lat, lon) from initial video frames
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Web Studio Server ---
HOST=0.0.0.0
PORT=8000
